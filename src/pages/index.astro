---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { DSA } from '../dsa';
import { BASE } from '../paths';

const sdLessons = await getCollection('lessons');
const dsaTotal = DSA.reduce((s, p) => s + p.problems.length, 0);
const dsaDone = DSA.reduce((s, p) => s + p.problems.filter((q) => q.done).length, 0);
---
<Base title="The Citadel">
  <header class="hero">
    <h1>🏰 The Citadel</h1>
    <p class="sub">
      One engineer's private war college. Two wings, two disciplines — pick today's fight.
      Somewhere past the misty mountains, the Gatekeeper is waiting.
    </p>
  </header>

  <div class="tracks">
    <a class="track sd" href={`${BASE}sd/`}>
      <div class="track-icon">🏗️</div>
      <h2>System Design</h2>
      <p>12 pattern-first modules · {sdLessons.length} lessons forged · quizzes, diagrams, walkthroughs.
      Lessons unlock in order; each ends in a live rep with the buddy.</p>
      <span class="cta">Enter the SD wing →</span>
    </a>
    <a class="track dsa" href={`${BASE}dsa/`}>
      <div class="track-icon">⚔️</div>
      <h2>DSA</h2>
      <p>20 patterns · {dsaTotal} problems, every one linked · {dsaDone} slain.
      Pattern lessons with Java templates, invariants, and your own bug bestiary.</p>
      <span class="cta">Enter the Arsenal →</span>
    </a>
  </div>

  <p class="foot-note">
    Progress lives in this browser and on the Notion campaign hub. Mocks, drills, and grills run with
    <code>/interview-buddy</code> — the Citadel is where you study; the buddy is where you bleed.
  </p>
</Base>

<style>
  .hero { text-align: center; margin: 2rem 0 2.5rem; }
  .hero h1 { font-size: 2.4rem; }
  .sub { color: var(--text-dim); max-width: 52ch; margin: 0.5rem auto 0; }
  .tracks { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  @media (max-width: 640px) { .tracks { grid-template-columns: 1fr; } }
  .track {
    display: block; padding: 1.6rem 1.5rem; border-radius: var(--radius);
    background: var(--bg-raised); border: 1px solid var(--border);
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .track:hover { transform: translateY(-2px); }
  .track.sd:hover { border-color: var(--blue); }
  .track.dsa:hover { border-color: var(--accent); }
  .track-icon { font-size: 2rem; }
  .track h2 { border: none; margin: 0.5rem 0 0.4rem; }
  .track p { color: var(--text-dim); font-size: 0.92rem; }
  .track.sd .cta { color: var(--blue); font-weight: 600; font-size: 0.92rem; }
  .track.dsa .cta { color: var(--accent); font-weight: 600; font-size: 0.92rem; }
  .foot-note { text-align: center; color: var(--text-dim); font-size: 0.85rem; margin-top: 2.5rem; }
</style>
